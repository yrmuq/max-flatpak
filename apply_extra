#!/bin/sh
set -eu

DATA=$(bsdtar -tf MAX.deb | awk '/^data\.tar/{print; exit}')
if [ -z "$DATA" ]; then
    echo "Error: MAX.deb has no data.tar payload" >&2
    bsdtar -tf MAX.deb >&2 || true
    exit 1
fi

mkdir -p payload
bsdtar -Oxf MAX.deb "$DATA" | bsdtar -xf - -C payload

if [ ! -d payload/usr/share/max ]; then
    echo "Error: deb has no usr/share/max" >&2
    find payload -maxdepth 4 -type d >&2 || true
    exit 1
fi

mv payload/usr/share/max ./max
rm -rf payload MAX.deb

test -x max/bin/max
ln -sfn ../bin/max-service/lib64/libpulsecommon-14.0.so max/lib64/libpulsecommon-14.0.so
